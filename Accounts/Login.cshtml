@model RaceDay.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";

}
<div class="container mt-5">
    <div class="row justifiy-content">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="class-header bg-primary text-white text-center">
                    <h3>RaceDay</h3>
                    <p class="mb-0">Event Mangement System</p>
                   
                </div>
                <div class="card-body p-4">
                    <h4 class="text-center mb-4">Welcome Back</h4>
                    <form asp-controller="Account"
                    asp-action="Login"
                    method="post">
                    <div asp-validation-summary="ModelOnly"
                    class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email"
                        class="form-control"
                        placeholder="Enter your email" />
                        <span asp-validation-for="Email"
                        class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password"
                        class="form-control"
                        placeholder="Enter your password" />
                        <span asp-validation-for="Password"
                        class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>
                </>
                <div class="text-center mt-3">
                    <p>Don't have an acoount?'</p>
                    <a asp-controller="Account"
                    asp-action="Register">Register here</a>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial
        name="_ValidationScriptsPartial" />
}
