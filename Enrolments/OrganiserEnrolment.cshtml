@model List<RaceDay.Web.ViewModels.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Manage Enrolments</h1>
        <p class="lead">
            View participants enrolled in your events.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No participants have enrolled in your events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EventName</td>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>
                                @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="badge bg-success">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>
